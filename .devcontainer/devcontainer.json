{
  "name": "convertor",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [3000, 5174, 5001],
  "runArgs": [
    "-p", "80:80",
    "-p", "3000:3000",
    "-p", "5174:5174",
    "-p", "5001:5001"
  ],
  "remoteUser": "node",
  "postCreateCommand": "make -C src/ install",
  "workspaceFolder": "/workspaces/convertor"
}